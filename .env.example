# TimescaleDB / PostgreSQL
POSTGRES_USER=iiot
POSTGRES_PASSWORD=change_me
POSTGRES_DB=asset_health
# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me
# MQTT (one account for the simulator, both Node-RED instances, and mosquitto_sub)
MQTT_USER=nodered
MQTT_PASSWORD=change_me
# Node-RED editor login (both 1881 and 1882) and credential encryption
NODE_RED_CREDENTIAL_SECRET=change_me
NODE_RED_ADMIN_USER=admin
NODE_RED_ADMIN_PASSWORD=change_me
# OPC UA (optional — Prosys on Windows host; leave unused while mqtt-simulator is the source)
OPCUA_ENDPOINT=opc.tcp://host.docker.internal:53530/OPCUA/SimulationServer
# Modbus TCP (node-red-ingestion polls modbus-slave)
MODBUS_HOST=modbus-slave
MODBUS_PORT=502
MODBUS_UNIT_ID=1
