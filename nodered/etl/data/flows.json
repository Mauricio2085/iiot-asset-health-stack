    {
        "id": "d34f09b0cd51ef0a",
        "type": "function",
        "z": "381ca58481ca40b3",
        "name": "Validate and enrich",
        "func": "const [plant, area, assetFromTopic] = msg.topic.split('/');\nconst p = msg.payload;\nconst errors = [];\nif (typeof p !== 'object' || p === null) {\n    errors.push('payload is not a JSON object');\n} else {\n    if (p.asset_id !== assetFromTopic) errors.push('asset_id does not match topic');\n    for (const field of ['temperature', 'pressure', 'vibration']) {\n        if (typeof p[field] !== 'number' || !Number.isFinite(p[field])) {\n            errors.push(`${field} is not a number`);\n        }\n    }\n    if (Number.isNaN(Date.parse(p.ts))) errors.push('ts is not a valid timestamp');\n}\nif (errors.length > 0) {\n    msg.errors = errors;\n    return [null, msg];\n}\nmsg.payload = {\n    time: p.ts,\n    plant,\n    area,\n    asset_id: p.asset_id,\n    temperature: p.temperature,\n    pressure: p.pressure,\n    vibration: p.vibration,\n    quality: p.quality ?? 'unknown'\n};\nreturn [msg, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
