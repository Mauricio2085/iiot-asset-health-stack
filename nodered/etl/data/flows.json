                "c5e82a17d9f0463b"
            ]
        ]
    },
    {
        "id": "c5e82a17d9f0463b",
        "type": "function",
        "z": "381ca58481ca40b3",
        "name": "Match registry",
        "func": "const reading = msg.reading;\nconst rows = Array.isArray(msg.payload) ? msg.payload : [];\nif (!reading) {\n    msg.errors = ['reading missing before registry check'];\n    return [null, msg];\n}\nif (rows.length === 0) {\n    msg.payload = reading;\n    msg.errors = ['asset_id is not in the asset registry'];\n    return [null, msg];\n}\nconst registered = rows[0];\nif (registered.plant !== reading.plant || registered.area !== reading.area) {\n    msg.payload = reading;\n    msg.errors = ['plant or area does not match the asset registry'];\n    return [null, msg];\n}\nmsg.payload = reading;\nreturn [msg, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 900,
        "y": 280,
