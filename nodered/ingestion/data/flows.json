        "func": "let valoresProsys = (msg.payload && msg.payload.hasOwnProperty('value')) ? msg.payload.value : msg.payload;\nlet tempActual = valoresProsys[\"ns=3;s=criticalTemp1\"]\nlet pressActual = valoresProsys[\"ns=3;s=criticalPressure1\"]\nlet vibrActual = valoresProsys[\"ns=3;s=criticalVibration1\"]\n\nmsg.payload= {\n    \"asset_id\":\"critical-pump-01\",\n    \"ts\":new Date().toISOString(),\n    \"vibration\":vibrActual,\n    \"temperature\":tempActual,\n    \"pressure\":pressActual,\n    \"quality\": \"good\"\n    };\n\nreturn msg;",
