  {
    "id": "d5c4b3a291807162",
    "type": "modbus-getter",
    "z": "a8f3e2c1b0d94e71",
    "name": "Read HR0-HR3",
    "showStatusActivities": true,
    "showErrors": true,
    "showWarnings": true,
    "logIOActivities": false,
    "unitid": "1",
    "dataType": "HoldingRegister",
    "adr": "0",
    "quantity": "4",
    "server": "b7e6d5c4a3928170",
    "useIOFile": false,
    "ioFile": "",
    "useIOForPayload": false,
    "emptyMsgOnFail": false,
    "keepMsgProperties": false,
    "delayOnStart": false,
    "startDelayTime": "",
    "x": 360,
    "y": 160,
    "wires": [["e4d3c2b1a0908172"], []]
  },
  {
    "id": "e4d3c2b1a0908172",
    "type": "function",
    "z": "a8f3e2c1b0d94e71",
    "name": "Scale and build payload",
    "func": "const regs = Array.isArray(msg.payload)\n    ? msg.payload\n    : (msg.payload && Array.isArray(msg.payload.data) ? msg.payload.data : null);\nif (!regs || regs.length < 4) {\n    node.warn('expected 4 holding registers, got: ' + JSON.stringify(msg.payload));\n    return null;\n}\nconst toNum = (v) => (typeof v === 'number' ? v : Number(v));\n// HR3 device status. An unknown code cannot vouch for the reading, so it maps to bad.\nconst QUALITY_BY_STATUS = { 0: 'good', 1: 'uncertain', 2: 'bad' };\nmsg.payload = {\n    asset_id: 'critical-motor-01',\n    ts: new Date().toISOString(),\n    temperature: toNum(regs[0]) / 10,\n    pressure: toNum(regs[1]) / 100,\n    vibration: toNum(regs[2]) / 100,\n    quality: QUALITY_BY_STATUS[toNum(regs[3])] ?? 'bad'\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 600,
    "y": 160,
    "wires": [["f3e2d1c0b9a08173", "a1b0c9d8e7f06174"]]
  },
