    "id": "a8f3e2c1b0d94e71",
    "type": "tab",
    "label": "Modbus TCP Ingestion",
    "disabled": false,
    "info": "Polls modbus-slave holding registers HR0-HR3 every 5 s, scales HR0-HR2, maps the HR3 device status to the contract quality, and publishes plant-01/area-01/critical-motor-01/telemetry. See docs/modbus-tcp.en.md.",
    "env": []
  },
